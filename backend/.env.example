DATABASE_URL="postgresql://funnel_app:funnel_dev_password@localhost:5432/funnel_db?schema=public"

# JWT
JWT_SECRET="change-me"
JWT_EXPIRES_IN="12h"

# Mật khẩu ban đầu cho tài khoản admin do seed script tạo
SEED_ADMIN_PASSWORD="change-me"

PORT=3000
FRONTEND_URL="http://localhost:5173"
# Danh sách origin được phép gọi API (CORS), cách nhau bằng dấu phẩy.
CORS_ORIGINS="http://localhost:5173"

# API key để xác thực POST /api/gsc/ingest (header x-api-key) - dán vào script
# Google Apps Script (backend/scripts/gsc-apps-script/Code.gs). Tạo bằng: openssl rand -hex 24
GSC_INGEST_API_KEY="change-me"

# Trợ lý AI (Claude API) - lấy key tại console.anthropic.com. Để trống thì app vẫn chạy,
# chỉ riêng trang Trợ lý AI báo "chưa cấu hình".
ANTHROPIC_API_KEY=""
# Chỉ điền khi key không gắn với workspace nào (lỗi 400 "must include the anthropic-workspace-id header").
# Cách đơn giản hơn: tạo key ngay trong một workspace ở Console thì bỏ trống dòng này.
ANTHROPIC_WORKSPACE_ID=""
ASSISTANT_MODEL="claude-opus-5"
# low | medium | high - mức suy nghĩ của model; cao hơn = kỹ hơn nhưng chậm và tốn token hơn.
ASSISTANT_EFFORT="medium"
# "default" = khi model từ chối nhầm, API tự chạy lại bằng model dự phòng. Để trống để tắt
# (cần tắt nếu đổi ASSISTANT_MODEL sang model không hỗ trợ tính năng này).
ASSISTANT_FALLBACKS="default"
# Số tin nhắn tối đa mỗi người dùng được gửi mỗi ngày (tính theo giờ Việt Nam).
ASSISTANT_DAILY_MSG_LIMIT=50
