generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  manager
  sales
  seo
}

enum UserStatus {
  active
  invited
  disabled
}

enum WebsiteStatus {
  connected
  error
  pending
}

enum SyncScope {
  traffic
  keywords
}

enum SyncStatus {
  success
  failed
  running
}

enum LeadChannel {
  form_web
  zalo
  fanpage
  hotline
  chat
}

enum LeadStatus {
  moi
  dang_cham_soc
  da_chuyen_don
  huy
}

enum OrderStatus {
  cho_xu_ly
  da_giao
  huy
}

enum AuditAction {
  create
  update
  delete
}

enum LeadActivityType {
  call
  message
  meeting
  email
  other
}

/// `tool` = kết quả tool gửi lại cho model (gửi lên API với role "user"),
/// tách riêng để đếm/cắt lịch sử theo tin nhắn thật của người dùng.
enum AssistantMessageRole {
  user
  assistant
  tool
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role
  team         String?
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  salesLeads    Lead[]     @relation("LeadSalesRep")
  createdLeads  Lead[]     @relation("LeadCreatedBy")
  salesOrders   Order[]    @relation("OrderSalesRep")
  createdOrders Order[]    @relation("OrderCreatedBy")
  auditLogs     AuditLog[]
  assistantConversations AssistantConversation[]
  leadActivities         LeadActivity[]
  reminders              Reminder[]

  @@map("users")
}

model Website {
  id          String        @id @default(cuid())
  name        String
  domain      String        @unique
  gscProperty String        @map("gsc_property")
  status      WebsiteStatus @default(pending)
  // Link "Publish to web" (CSV) từ Google Sheet dùng add-on Search Analytics
  // for Sheets - thay cho gọi trực tiếp GSC API (tránh phải tạo GCP project).
  trafficCsvUrl  String?     @map("traffic_csv_url")
  keywordsCsvUrl String?     @map("keywords_csv_url")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  dailyTraffic GscDailyTraffic[]
  keywords     GscKeyword[]
  leads        Lead[]
  orders       Order[]
  syncLogs     SyncLog[]
  hostings     HostingAccount[]

  @@map("websites")
}

model GscDailyTraffic {
  id          String  @id @default(cuid())
  websiteId   String  @map("website_id")
  date        DateTime @db.Date
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, date])
  @@index([websiteId, date])
  @@map("gsc_daily_traffic")
}

model GscKeyword {
  id             String   @id @default(cuid())
  websiteId      String   @map("website_id")
  rangeStart     DateTime @db.Date @map("range_start")
  rangeEnd       DateTime @db.Date @map("range_end")
  query          String
  clicks         Int
  impressions    Int
  ctr            Float
  position       Float
  syncedAt       DateTime @default(now()) @map("synced_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  // Bảng lưu snapshot hiện tại (cửa sổ trượt 28 ngày), không lưu lịch sử từng ngày -
  // nên khoá duy nhất chỉ theo (website, từ khoá), mỗi lần sync ghi đè snapshot cũ.
  @@unique([websiteId, query])
  @@map("gsc_keywords")
}

model Lead {
  id           String      @id @default(cuid())
  date         DateTime    @db.Date
  websiteId    String      @map("website_id")
  customerName String      @map("customer_name")
  contact      String
  channel      LeadChannel
  interest     String
  salesRepId   String      @map("sales_rep_id")
  status       LeadStatus  @default(moi)
  note         String?
  createdById  String      @map("created_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  website   Website @relation(fields: [websiteId], references: [id])
  salesRep  User    @relation("LeadSalesRep", fields: [salesRepId], references: [id])
  createdBy User    @relation("LeadCreatedBy", fields: [createdById], references: [id])
  activities LeadActivity[]
  reminders  Reminder[]
  orders    Order[]

  @@index([websiteId, date])
  @@index([status])
  @@index([salesRepId])
  @@map("leads")
}

model Order {
  id         String      @id @default(cuid())
  date       DateTime    @db.Date
  leadId     String?     @map("lead_id")
  websiteId  String      @map("website_id")
  value      Int
  product    String
  salesRepId String      @map("sales_rep_id")
  status     OrderStatus @default(cho_xu_ly)
  createdById String     @map("created_by_id")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  deletedAt  DateTime?   @map("deleted_at")

  website   Website @relation(fields: [websiteId], references: [id])
  lead      Lead?   @relation(fields: [leadId], references: [id])
  salesRep  User    @relation("OrderSalesRep", fields: [salesRepId], references: [id])
  createdBy User    @relation("OrderCreatedBy", fields: [createdById], references: [id])

  @@index([websiteId, date])
  @@index([status])
  @@index([salesRepId])
  @@map("orders")
}

model SyncLog {
  id        String     @id @default(cuid())
  websiteId String     @map("website_id")
  scope     SyncScope
  status    SyncStatus
  rows      Int        @default(0)
  message   String?
  runAt     DateTime   @default(now()) @map("run_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, runAt])
  @@map("sync_logs")
}

model AuditLog {
  id         String      @id @default(cuid())
  entityType String      @map("entity_type") // "lead" | "order"
  entityId   String      @map("entity_id")
  action     AuditAction
  field      String?
  oldValue   String?     @map("old_value")
  newValue   String?     @map("new_value")
  changedById String     @map("changed_by_id")
  changedAt  DateTime    @default(now()) @map("changed_at")

  changedBy User @relation(fields: [changedById], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model AssistantConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  persona   String // "seo" - sau này thêm "sales", "admin"
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  // Cập nhật mỗi khi có tin nhắn mới - cron xoá hội thoại không hoạt động quá 90 ngày dựa vào cột này.
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([userId, updatedAt])
  @@index([updatedAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id              String               @id @default(cuid())
  conversationId  String               @map("conversation_id")
  role            AssistantMessageRole
  // Nguyên content blocks của Claude API (text, thinking, tool_use, tool_result...) -
  // phải gửi lại đúng như cũ ở lượt sau, không chỉ phần text.
  content         Json
  inputTokens     Int?                 @map("input_tokens")
  outputTokens    Int?                 @map("output_tokens")
  cacheReadTokens Int?                 @map("cache_read_tokens")
  cacheWriteTokens Int?                @map("cache_write_tokens")
  createdAt       DateTime             @default(now()) @map("created_at")

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

/// Mỗi lần nhân viên liên hệ khách (gọi, nhắn, gặp...). Là nguồn "lần chăm sóc gần nhất" thật,
/// thay cho updatedAt của lead (có thể chỉ là ngày import).
model LeadActivity {
  id         String           @id @default(cuid())
  leadId     String           @map("lead_id")
  userId     String           @map("user_id")
  type       LeadActivityType
  note       String?
  happenedAt DateTime         @default(now()) @map("happened_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([leadId, happenedAt])
  @@map("lead_activities")
}

/// Lịch nhắc chăm sóc khách - nhắc chính người tạo (userId), hiện trong mục "Việc cần làm".
model Reminder {
  id        String    @id @default(cuid())
  leadId    String    @map("lead_id")
  userId    String    @map("user_id")
  dueAt     DateTime  @map("due_at")
  note      String
  doneAt    DateTime? @map("done_at")
  /// "manual" (tạo trên trang Lead) | "assistant" (Trợ lý AI tạo theo yêu cầu người dùng)
  source    String    @default("manual")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([userId, doneAt, dueAt])
  @@index([leadId])
  @@map("reminders")
}

/// Tài khoản đăng nhập hosting/quản trị của từng website (chỉ admin xem được).
/// Mật khẩu phải xem lại được nên không băm mà mã hoá AES-256-GCM bằng HOSTING_SECRET_KEY
/// (xem src/common/secret-box.ts) - lộ database cũng không đọc được nếu không có key.
model HostingAccount {
  id                String   @id @default(cuid())
  websiteId         String   @map("website_id")
  /// VD: "Hosting", "cPanel", "Tên miền", "WordPress admin"
  label             String   @default("Hosting")
  loginUrl          String   @map("login_url")
  username          String?
  passwordEncrypted String?  @map("password_encrypted")
  note              String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@map("hosting_accounts")
}
